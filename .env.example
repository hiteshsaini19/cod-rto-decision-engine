# Copy this file to .env and paste your key. Without a key the app still works (rules only).
# Free key: https://openrouter.ai -> sign in -> Keys -> Create key
OPENROUTER_API_KEY=your-key-here

# Optional: which free models to try, in order (free models come and go - see https://openrouter.ai/models?q=free)
# OPENROUTER_MODELS=dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-lightning:free

# Optional
# LLM_TIMEOUT_SECONDS=25
# LLM_TOTAL_BUDGET_SECONDS=45
# BRAND_NAME=Haircare Store
# BACKEND_URL=http://localhost:8000
